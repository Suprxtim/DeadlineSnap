{
    "manifest_version": 3,
    "name": "DeadlineSnap",
    "version": "1.0.0",
    "description": "Never miss a deadline. Right-click any opportunity screenshot, AI extracts the deadline.",
    "permissions": [
        "contextMenus",
        "notifications",
        "alarms",
        "storage",
        "activeTab",
        "tabs"
    ],
    "host_permissions": [
        "<all_urls>",
        "https://api.telegram.org/*"
    ],
    "background": {
        "service_worker": "background/service-worker.js",
        "type": "module"
    },
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "assets/icons/icon16.png",
            "48": "assets/icons/icon48.png",
            "128": "assets/icons/icon128.png"
        }
    },
    "icons": {
        "16": "assets/icons/icon16.png",
        "48": "assets/icons/icon48.png",
        "128": "assets/icons/icon128.png"
    },
    "options_page": "options/options.html",
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content/content.js",
                "content/widget.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "content/widget.css"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "commands": {
        "capture-screenshot": {
            "suggested_key": {
                "default": "Ctrl+Shift+S",
                "mac": "Command+Shift+S"
            },
            "description": "Capture current tab screenshot"
        },
        "toggle-widget": {
            "suggested_key": {
                "default": "Ctrl+Shift+D",
                "mac": "Command+Shift+D"
            },
            "description": "Toggle deadline widget visibility"
        }
    }
}